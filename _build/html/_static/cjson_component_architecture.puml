@startuml cjson_component_architecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12

title cJSON v1.7.19 — Component Architecture

package "cJSON Core (cJSON.c)" as core #BFD8D2 {
  [Parser] as parser
  [Printer] as printer
  [Object Model] as model
  [Memory Manager] as mem
}

package "cJSON Utils (cJSON_Utils.c)" as utils #FEDCD2 {
  [JSON Patch\n(RFC 6902)] as patch
  [JSON Pointer\n(RFC 6901)] as pointer
  [Sort / Merge] as sort
}

package "C Standard Library" as stdlib #DFCCF1 {
  [malloc/free] as malloc
  [string ops] as string
  [float/int math] as math
}

cloud "Integrator Application" as app #DCB239 {
  [Safety-Qualified\nAllocator] as safe_alloc
  [Input Validation] as input_val
}

() "Public API\n(78 functions)" as api

app --> api : calls
api --> core
api --> utils
utils --> core : uses
core --> stdlib : depends on
printer --> model : traverses
parser --> model : constructs
mem --> malloc : default
mem --> safe_alloc : hook\n(cJSON_InitHooks)

note right of core
  ~3,190 LOC
  C99, zero dependencies
  -Werror clean build
end note

@enduml
