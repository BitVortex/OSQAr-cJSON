@startuml cjson_parser_flow
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11

title cJSON Parser — JSON Parsing Flow

actor "Caller" as caller

participant "cJSON_Parse" as parse
participant "cJSON_ParseWithOpts" as opts
participant "parse_value" as pv
participant "parse_string" as ps
participant "parse_number" as pn
participant "parse_array" as pa
participant "parse_object" as po

caller -> parse : JSON text (const char*)
parse -> opts : default options
opts -> pv : skip_whitespace(), parse_value()

pv -> pv : read first token

alt token == '"'
  pv -> ps : parse UTF-8 string
  ps --> pv : cJSON item (string)
else token in [-0-9]
  pv -> pn : parse IEEE 754 number
  pn --> pv : cJSON item (number)
else token == '['
  pv -> pa : recursive parse array
  pa -> pv : parse_value() for each element
  pa --> pv : cJSON item (array)
else token == '{'
  pv -> po : recursive parse object
  po -> pv : parse_value() for each value
  po --> pv : cJSON item (object)
else token in 'tfn'
  pv --> pv : cJSON item (true/false/null)
end

pv --> opts : cJSON* root
opts -> opts : check depth limit\n(CJSON_NESTING_LIMIT=1000)
opts --> parse : cJSON* or NULL
parse --> caller : cJSON* (success) or NULL (error)

note right of pa
  Recursion depth bounded
  by CJSON_NESTING_LIMIT.
  Error on overflow.
end note

note right of po
  Key uniqueness not
  enforced — integrator
  responsibility.
end note

@enduml
