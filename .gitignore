# Python cache
__pycache__/
*.pyc
*.pyo

# Sphinx build output (CI-generated, not committed)
_build/

# Shipment artifacts (CI-generated, attached to releases)
_shipment/

# Build evidence (generated by CI pipeline — not committed)
test_results.xml
coverage_report.txt
complexity_report.txt

# Rendered PlantUML images (generated at build time from .puml sources)
_static/*.png

# GSN diagram artifacts (generated by CI — not committed)
_static/gsn_safety_case.svg
_static/gsn_safety_case.yaml

# cJSON build artifacts (submodule)
cjson-source/build/
cjson-source/*.o
cjson-source/*.gcno
cjson-source/*.gcda
cjson-source/*.gcov

# LaTeX intermediates (paper prevention — no paper in this repo)
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz *.lof *.lot *.nav *.snm *.vrb *.run.xml *.bcf

# Editor temp
*.swp
*.swo
*~

# PDFs are deliverables — always committed
!*.pdf

# Shipment ZIP artifact (CI-generated, attached to releases)
osqar_cjson_shipment.zip
osqar_cjson_shipment.zip.sha256

# GPG keyring (local only)
*.kbx
*.gpg
*.secring
*.pubring
trustdb.gpg
