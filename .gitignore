# Python cache
__pycache__/
*.pyc
*.pyo

# Sphinx build output (CI-generated, not committed)
_build/

# Shipment artifacts (CI-generated, attached to releases)
_shipment/

# Build evidence (generated by CI pipeline — not committed)
test_results.xml
coverage_report.txt
complexity_report.txt

# Rendered PlantUML images (generated at build time from .puml sources)
_static/*.png

# cJSON build artifacts (submodule)
cjson-source/build/
cjson-source/*.o
cjson-source/*.gcno
cjson-source/*.gcda
cjson-source/*.gcov

# LaTeX intermediates (paper prevention — no paper in this repo)
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz *.lof *.lot *.nav *.snm *.vrb *.run.xml *.bcf

# Editor temp
*.swp
*.swo
*~

# PDFs are deliverables — always committed
!*.pdf
